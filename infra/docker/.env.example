# ============================================
# Docker Configuration
# ============================================

# MySQL Database (Docker container)
MYSQL_ROOT_PASSWORD=your_root_password
MYSQL_USER=ems_user
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=ems_db

# Database Connection (used by backend to connect to MySQL container)
# These reference the MYSQL_* variables above
DB_HOST=mysql
DB_PORT=3306
DB_USER=${MYSQL_USER}
DB_PASSWORD=${MYSQL_PASSWORD}
DB_NAME=${MYSQL_DATABASE}

# Port Mapping (Docker host ports)
FRONTEND_PORT=3000
BACKEND_PORT=3001
PMA_PORT=8080

# Server Configuration
HOST=0.0.0.0
PORT=3001
NODE_ENV=development

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ============================================
# Application Configuration
# ============================================

# API URLs
VITE_API_URL=http://localhost:3001/api/v1
VITE_BASE=http://localhost:3001

# Vite HMR (Hot Module Replacement) for Docker
VITE_HMR_HOST=localhost
VITE_HMR_PORT=5173

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=3600
QR_TOKEN_SECRET=your_qr_token_secret_key_here

# LINE Official Account Configuration
LINE_CHANNEL_SECRET=your_line_channel_secret
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token

# LINE Rich Menu IDs
LINE_RICH_MENU_STAFF=richmenu-0fd067f1629b1eb3ddffd0d619aa0f6c
LINE_RICH_MENU_MEMBER=richmenu-105e3b56020a5d67fd5b09d40e154c84

# LIFF App IDs
VITE_LIFF_REGISTRATION=2008498720-KaJrlZBN
VITE_LIFF_TICKET=your_liff_ticket_id
VITE_LIFF_SURVEY=your_liff_survey_id
VITE_LIFF_CERTIFICATE=your_liff_certificate_id
VITE_LIFF_EXHIBITION=your_liff_exhibition_id
VITE_LIFF_NEWS=your_liff_news_id

# LIFF Mock Mode (for development)
VITE_LIFF_MOCK=false
VITE_MOCK_LINE_USER_ID=U1234567890abcdef1234567890abcdef
