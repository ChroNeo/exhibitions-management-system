# ============================================
# Production Environment Configuration
# ============================================
# Copy this file to .env.production and fill in your values:
#   cp .env.production.example .env.production
#
# IMPORTANT: Never commit .env.production to version control!
# ============================================

# ---- MySQL Database ----
MYSQL_ROOT_PASSWORD=CHANGE_ME_strong_root_password
MYSQL_USER=ems_user
MYSQL_PASSWORD=CHANGE_ME_strong_db_password
MYSQL_DATABASE=ems_db

# ---- Database Connection (used by backend) ----
DB_HOST=db
DB_PORT=3306
DB_USER=${MYSQL_USER}
DB_PASSWORD=${MYSQL_PASSWORD}
DB_NAME=${MYSQL_DATABASE}

# ---- Port Configuration ----
# Port the backend listens on inside the container
BACKEND_PORT=3001
# Port exposed to the host (the public-facing port)
APP_PORT=80

# ---- Server Configuration ----
HOST=0.0.0.0
PORT=3001
NODE_ENV=production

# ---- CORS Configuration ----
# Set to your server's public URL (IP or domain)
# Example: http://203.0.113.50 or https://ems.university.edu
ALLOWED_ORIGINS=http://YOUR_SERVER_IP

# ---- API URLs ----
# IMPORTANT: These are baked into the frontend at build time.
# Set to your server's public URL.
VITE_API_URL=http://YOUR_SERVER_IP/api/v1
VITE_BASE=http://YOUR_SERVER_IP

# ---- JWT Configuration ----
# Generate strong secrets: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
JWT_EXPIRES_IN=3600
QR_TOKEN_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32

# ---- LINE Official Account ----
LINE_CHANNEL_SECRET=your_line_channel_secret
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token

# ---- LINE Rich Menu IDs ----
LINE_RICH_MENU_STAFF=richmenu-xxxxxxxxxxxx
LINE_RICH_MENU_MEMBER=richmenu-xxxxxxxxxxxx

# ---- LIFF App IDs ----
VITE_LIFF_REGISTRATION=your_liff_registration_id
VITE_LIFF_TICKET=your_liff_ticket_id
VITE_LIFF_SURVEY=your_liff_survey_id
VITE_LIFF_CERTIFICATE=your_liff_certificate_id
VITE_LIFF_EXHIBITION=your_liff_exhibition_id
VITE_LIFF_NEWS=your_liff_news_id

# ---- LIFF Mock (MUST be false in production) ----
VITE_LIFF_MOCK=false
